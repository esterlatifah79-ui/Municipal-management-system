#include <stdio.h>

void swapWrong(int a, int b) {
    int temp = a;
    a = b;
    b = temp;
}

void swapRight(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

int main() {
    int x = 10, y = 20;

    swapWrong(x, y);
    printf("Wrong: %d %d\n", x, y);

    swapRight(&x, &y);
    printf("Right: %d %d\n", x, y);

    return 0;
}