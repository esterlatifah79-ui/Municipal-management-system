#include <stdio.h>

int main() {
    float salary[50], total = 0, average, highest, lowest, search;
    int i, j, found = 0;
    float temp;

    for (i = 0; i < 50; i++) {
        printf("Enter salary for employee %d: ", i + 1);
        scanf("%f", &salary[i]);
        total += salary[i];
    }

    highest = lowest = salary[0];

    printf("\nAll Salaries:\n");

    for (i = 0; i < 50; i++) {
        printf("%.2f\n", salary[i]);

        if (salary[i] > highest)
            highest = salary[i];

        if (salary[i] < lowest)
            lowest = salary[i];
    }

    average = total / 50;

    printf("\nTotal Expenditure: NAD %.2f\n", total);
    printf("Average Salary: NAD %.2f\n", average);
    printf("Highest Salary: NAD %.2f\n", highest);
    printf("Lowest Salary: NAD %.2f\n", lowest);

    printf("\nEnter salary to search: ");
    scanf("%f", &search);

    for (i = 0; i < 50; i++) {
        if (salary[i] == search) {
            printf("Salary found at employee %d\n", i + 1);
            found = 1;
        }
    }

    if (found == 0)
        printf("Salary not found\n");

    for (i = 0; i < 49; i++) {
        for (j = 0; j < 49 - i; j++) {
            if (salary[j] > salary[j + 1]) {
                temp = salary[j];
                salary[j] = salary[j + 1];
                salary[j + 1] = temp;
            }
        }
    }

    printf("\nSalaries from Lowest to Highest:\n");

    for (i = 0; i < 50; i++) {
        printf("%.2f\n", salary[i]);
    }

    return 0;
}